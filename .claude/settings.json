{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "sonnet",
  "extraKnownMarketplaces": {
    "tsyukyo-tools": {
      "source": {
        "source": "github",
        "repo": "tsyukyo/claude-setup"
      }
    }
  },
  "enabledPlugins": {
    "dev-team@tsyukyo-tools": true
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(git worktree list:*)",
      "Bash(bash scripts/validate.sh)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)"
    ]
  }
}
